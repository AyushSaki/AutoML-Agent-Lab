<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dataset Intelligence | AutoML Agent Lab</title>
    <script src="https://cdn.plot.ly/plotly-3.0.1.min.js"></script>
    <style>
        :root {
            --bg: #f5f7fb;
            --card: #ffffff;
            --text: #172033;
            --muted: #64748b;
            --border: #e2e8f0;
            --blue: #2563eb;
            --green: #15803d;
            --orange: #c2410c;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        header {
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 20px 5%;
        }

        header h1 { margin: 0; font-size: 24px; }
        header p { margin: 7px 0 0; color: var(--muted); }

        main {
            max-width: 1400px;
            margin: 28px auto;
            padding: 0 22px 40px;
        }

        h2 { font-size: 19px; margin: 0 0 16px; }
        h3 { font-size: 15px; margin-top: 0; }

        .section { margin-bottom: 28px; }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 16px;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
            min-width: 0;
            box-shadow: 0 2px 7px rgba(15, 23, 42, .025);
        }

        .metric-label { color: var(--muted); font-size: 13px; }
        .metric-value { font-size: 28px; font-weight: 700; margin-top: 9px; }
        .muted { color: var(--muted); font-size: 13px; }
        .danger { color: #b91c1c; }
        .success { color: var(--green); }

        .table-wrap {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            font-size: 13px;
        }

        th, td {
            text-align: left;
            padding: 11px 13px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        th { background: #f8fafc; font-weight: 600; }
        tr:last-child td { border-bottom: none; }

        .chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 16px;
        }

        .chart { width: 100%; min-height: 300px; }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        select, button {
            padding: 11px 14px;
            border-radius: 8px;
            border: 1px solid var(--border);
            font-size: 14px;
        }

        select { background: white; min-width: 190px; }
        button {
            background: var(--blue);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: 600;
        }

        button:hover { background: #1d4ed8; }
        .full-width { grid-column: 1 / -1; }
        .pill {
            display: inline-block;
            padding: 4px 9px;
            background: #eff6ff;
            color: #1d4ed8;
            border-radius: 20px;
            font-size: 12px;
            margin: 3px;
        }

        @media (max-width: 600px) {
            main { padding: 0 12px 28px; }
            .chart-grid { grid-template-columns: 1fr; }
            header { padding: 18px 16px; }
        }
    </style>
</head>
<body>
<header>
    <h1>AutoML Agent Lab</h1>
    <p>Data Intelligence Engine · Dataset profiling and exploratory analysis</p>
</header>

<main>
    <section class="section">
        <div class="card">
            <h2>Dataset Overview</h2>
            <p><strong>File:</strong> {{ filename | default('Uploaded dataset') }}</p>
            <p class="muted">Review data quality and patterns before training a machine-learning model.</p>
        </div>
    </section>

    <section class="section">
        <div class="grid">
            <div class="card">
                <div class="metric-label">Rows</div>
                <div class="metric-value">{{ profile.rows | default(0) }}</div>
            </div>
            <div class="card">
                <div class="metric-label">Columns</div>
                <div class="metric-value">{{ profile.columns | default(0) }}</div>
            </div>
            <div class="card">
                <div class="metric-label">Missing Values</div>
                <div class="metric-value {{ 'danger' if profile.total_missing|default(0) > 0 else 'success' }}">
                    {{ profile.total_missing | default(0) }}
                </div>
            </div>
            <div class="card">
                <div class="metric-label">Duplicate Rows</div>
                <div class="metric-value">{{ profile.duplicate_rows | default(0) }}</div>
            </div>
            <div class="card">
                <div class="metric-label">Numeric Columns</div>
                <div class="metric-value">{{ profile.numeric_columns | default([]) | length }}</div>
            </div>
            <div class="card">
                <div class="metric-label">Categorical Columns</div>
                <div class="metric-value">{{ profile.categorical_columns | default([]) | length }}</div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Data Types</h2>
            {% if profile.dtypes %}
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Column</th><th>Data Type</th></tr></thead>
                    <tbody>
                    {% for column, dtype in profile.dtypes.items() %}
                        <tr><td>{{ column }}</td><td>{{ dtype }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <p class="muted">No data-type information available.</p>
            {% endif %}
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Missing Values by Column</h2>
            {% if profile.missing_by_column %}
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Column</th><th>Missing Count</th></tr></thead>
                    <tbody>
                    {% for column, count in profile.missing_by_column.items() %}
                        <tr>
                            <td>{{ column }}</td>
                            <td class="{{ 'danger' if count|int > 0 else 'success' }}">{{ count }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <p class="success">No missing values were reported.</p>
            {% endif %}
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Statistical Summary</h2>
            {% if profile.statistics %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Column</th>
                            <th>Statistic</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for column, stats in profile.statistics.items() %}
                        {% if stats is mapping %}
                            {% for stat_name, value in stats.items() %}
                            <tr>
                                <td>{{ column }}</td>
                                <td>{{ stat_name }}</td>
                                <td>{{ value }}</td>
                            </tr>
                            {% endfor %}
                        {% else %}
                            <tr><td>{{ column }}</td><td>Summary</td><td>{{ stats }}</td></tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <p class="muted">No statistical summary available.</p>
            {% endif %}
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Outlier Summary (IQR)</h2>
            {% if profile.outlier_summary %}
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Column</th><th>Outlier Information</th></tr></thead>
                    <tbody>
                    {% for column, info in profile.outlier_summary.items() %}
                        <tr>
                            <td>{{ column }}</td>
                            <td>
                                {% if info is mapping %}
                                    {% for key, value in info.items() %}
                                        <strong>{{ key }}:</strong> {{ value }}{% if not loop.last %} · {% endif %}
                                    {% endfor %}
                                {% else %}
                                    {{ info }}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <p class="muted">No outlier information available.</p>
            {% endif %}
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Categorical Distributions</h2>
            {% if profile.categorical_distributions %}
            <div class="grid">
                {% for column, distribution in profile.categorical_distributions.items() %}
                <div class="card">
                    <h3>{{ column }}</h3>
                    {% if distribution is mapping %}
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Value</th><th>Count</th></tr></thead>
                            <tbody>
                            {% for value, count in distribution.items() %}
                                <tr><td>{{ value }}</td><td>{{ count }}</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                        <p>{{ distribution }}</p>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% else %}
                <p class="muted">No categorical distributions available.</p>
            {% endif %}
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Interactive Exploratory Data Analysis</h2>
            <p class="muted">Charts are interactive: hover to inspect values, zoom, and use the Plotly toolbar.</p>
            {% if profile.charts %}
            <div class="chart-grid">
                {% for chart_name, chart in profile.charts.items() %}
                <div class="card">
                    <h3>{{ chart_name | replace('_', ' ') | title }}</h3>
                    <div class="chart" id="chart-{{ loop.index }}"></div>
                </div>
                {% endfor %}
            </div>
            {% else %}
                <p class="muted">No charts were generated for this dataset.</p>
            {% endif %}
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Dataset Preview</h2>
            {% if profile.preview and profile.column_names %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>{% for column in profile.column_names %}<th>{{ column }}</th>{% endfor %}</tr>
                    </thead>
                    <tbody>
                    {% for row in profile.preview %}
                        <tr>
                        {% for column in profile.column_names %}
                            <td>{{ row[column] if row is mapping else '' }}</td>
                        {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <p class="muted">No preview available.</p>
            {% endif %}
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Train and Compare Models</h2>
            <p class="muted">Choose a target column if you want supervised classification or regression.</p>
            <form action="{{ url_for('train') }}" method="post">
                <input type="hidden" name="file_path" value="{{ profile.file_path | default(file_path | default('')) }}">
                <div class="actions">
                    <label for="target">Target column:</label>
                    <select name="target" id="target">
                        <option value="">Automatic / Unspecified</option>
                        {% for column in profile.column_names | default([]) %}
                            <option value="{{ column }}">{{ column }}</option>
                        {% endfor %}
                    </select>

                    <label for="task">Task:</label>
                    <select name="task" id="task">
                        <option value="auto">Auto Detect</option>
                        <option value="classification">Classification</option>
                        <option value="regression">Regression</option>
                    </select>

                    <button type="submit">Train Models</button>
                </div>
            </form>
            <p class="muted">Training results depend on the dataset, selected target, and supported algorithms.</p>
        </div>
    </section>

    <div class="actions">
        <a href="{{ url_for('index') }}">← Upload another dataset</a>
    </div>
</main>

<script>
    const charts = [
        {% for chart_name, chart in profile.charts.items() %}
        {
            id: "chart-{{ loop.index }}",
            data: {{ chart.get('data', []) | tojson }},
            layout: {{ chart.get('layout', {}) | tojson }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    if (window.Plotly) {
        charts.forEach(function(chart) {
            Plotly.newPlot(
                chart.id,
                chart.data,
                chart.layout,
                { responsive: true, displaylogo: false }
            );
        });
    }
</script>
</body>
</html>
