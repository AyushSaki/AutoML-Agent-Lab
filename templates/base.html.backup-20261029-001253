<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}AutoML-Agent-Lab{% endblock %}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
</head>
<body>
<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold text-dark" href="{{ url_for('index') }}">◈ AutoML-Agent-Lab</a>
    <a class="nav-link" href="{{ url_for('experiments') }}">Experiment History</a>
        <span class="navbar-text text-secondary small">Autonomous Machine Learning Platform</span>
  </div>
<a class="nav-link" href="{{ url_for('project_planner') }}">Project Planner</a>
<a class="nav-link" href="{{ url_for('dataset_lab') }}">Dataset Lab</a>
<a class="nav-link" href="{{ url_for('dataset_compare') }}">Compare Datasets</a>
<a class="nav-link" href="{{ url_for('dataset_discovery') }}">Discover Datasets</a>
</nav>
<main class="container py-4">
{% with messages = get_flashed_messages(with_categories=true) %}
  {% for category, message in messages %}
  <div class="alert alert-{{ 'danger' if category == 'error' else category }} shadow-sm">{{ message }}</div>
  {% endfor %}
{% endwith %}
{% block content %}{% endblock %}
</main>
<footer class="border-top bg-white py-3 mt-5">
  <div class="container text-secondary small">Local-first • Free/Open Source • Flask + Scikit-learn + Ollama</div>
</footer>
</body>
</html>